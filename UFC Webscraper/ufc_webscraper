def weight_class(event_link, fight_link, weight):
    weight_class_dict = {"Flyweight" : 125,
    "Bantamweight" : 135,
    "Featherweight" : 145,
    "Lightweight" : 155,
    "Welterweight": 170,
    "Middleweight": 185,
    "Light Heavyweight": 205,
    "Heavyweight":265}
    for _ in range(5):
        try:
            response = requests.get(event_link)
            if response.status_code == 200:
                soup = BeautifulSoup(response.content, "lxml")
                date_obj = soup.find("i", class_="b-list__box-item-title") if soup.find("i", class_="b-list__box-item-title").get_text(strip=True) == "Date:" else "N/A"
                date = date_obj.next_sibling.get_text(strip=True) if date_obj != "N/A" else "N/A"
                event_fights = soup.find("tbody", class_="b-fight-details__table-body").find_all("tr")
                fight_event = []
                for i in event_fights:
                    if i.get("data-link") == fight_link:
                        fight_event = i.find_all("p", class_="b-fight-details__table-text")
                        break
                for i in fight_event:
                    if "weight" in i.get_text(strip=True).lower():
                        return (weight_class_dict[i.get_text(strip=True)] if i.get_text(strip=True) in weight_class_dict else weight), date
        except requests.exceptions.RequestException as e:
            time.sleep(5)

def update_csv(fighter_links, month_abbr):
    fighters = []
    opp_links = []
    opps = []
    
    # Process fighters in batches to reduce memory usage
    batch_size = 4
    for batch_start in range(0, len(fighter_links), batch_size):
        batch_links = fighter_links[batch_start:batch_start + batch_size]
        
        for i in batch_links:
            # Fetch data from the URL with retry mechanism
            fighter_link = i.strip()
            for _ in range(5):
                try:
                    response = requests.get(i)
                    if response.status_code == 200:
                        break
                except requests.exceptions.RequestException as e:
                    time.sleep(5)

            soup = BeautifulSoup(response.content, "html.parser")
            outcomes_html = soup.find_all(
                "tr", class_="b-fight-details__table-row b-fight-details__table-row__hover js-fight-details-click"
            )[:10]
            links = []
            fight_outcomes = []
            for i in outcomes_html:
                link = i['data-link']
                status = i.find("i", class_="b-flag__text").get_text(strip=True)
                if status not in ["nc", "draw", "next"]:
                    links.append(link)
                    fight_outcomes.append(i)
            del outcomes_html
            # Extract fighter info
            fighter_name, height, weight, reach, wins, losses, dob= fighter_base_stats(soup, month_abbr)
            fighters.append(fighter_name)

            # Check if the fighter exists in the dataset
            # Process fight history
            fight_links, opponent_links, opp_names = fighter_history(links, fighter_name, fight_outcomes, height, reach, overwrite=True)
            if fight_links is None:
                print(f"{fighter_name} is up to date in the database.")
                del soup, links, fight_outcomes, fighter_name, height, weight, reach, wins, losses, fight_links, opponent_links, opp_names
                gc.collect()
                continue

            # Append opponent data
            opp_links.extend(opponent_links)
            opps.extend(opp_names)

            # Process fight performance
            fighter_performance = fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, month_abbr, False, fighter_link, dob)
            with open('UFC Fighter Dataset.csv', 'a', newline='') as file:
                writer = csv.writer(file)
                for row in fighter_performance:
                    writer.writerow(row)

            # Process fight outcomes
            fighter_outcome = fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, month_abbr, True, fighter_link, dob)
            with open('UFC Outcomes.csv', 'a', newline='') as file:
                writer = csv.writer(file)
                for row in fighter_outcome:
                    writer.writerow(row)

            # Cleanup
            del soup, links, fight_outcomes, fighter_name, height, weight, reach, wins, losses, fight_links, opponent_links, opp_names
            gc.collect()

        # Force garbage collection after each batch
        gc.collect()

    df = pd.read_csv("UFC Fighter Dataset.csv")
    # Save updated dataframes to CSV
    print(f"# OF FIGHTERS CURRENTLY ADDED: {df['Fighter Name'].nunique()}")
    print(f"LAST FIGHTER ADDED: {df.iloc[-1]['Fighter Name']}")
    return fighters, opp_links, opps


def fit_for_training(check = False, fighter_input = None):
    if check:
        fighters = fighter_input
    else:
        fighter_input = str(input("Enter Fighter To Check: ")).strip()
        fighters = fighter_input.strip().split(",")
    for fighter_name in fighters:
        fighter_names = []
        fighter_name = fighter_name.strip()
        with open("UFC Outcomes.csv", 'rt') as f:
            reader = csv.reader(f, delimiter=',')
            for row in reader:
                if fighter_name == row[0].strip():
                    fighter_names.append(row[2])
        if len(fighter_names) < 1:
            print(f"{fighter_name} is not fit for training:\nError Type: Fighter not logged in UFC Outcomes.")
            break
        else:
            fighter_dupe = fighter_names.copy()
            for i in fighter_names:
                with open("UFC Fighter Dataset.csv", 'rt') as f:
                    reader = csv.reader(f, delimiter=',')
                    for row in reader:
                        if i == row[0].strip():
                            fighter_dupe.remove(i)
                            break
            if len(fighter_dupe) == 0:
                print(f"{fighter_name} is fit for training")
                if (fighter_name + "\n") not in train_list:
                    train_txt = open("Train_Test Fighters.txt", "a")
                    train_txt.write(fighter_name + "\n")
            else:
                print(f"{fighter_name} is not fit for training\nError Type: Opponent Fight History not in database.\nMissing Fighters:\n{fighter_dupe}")      


