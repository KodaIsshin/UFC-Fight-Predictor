def weight_class(event_link, fight_link, weight):
    weight_class_dict = {"Flyweight" : 125,
    "Bantamweight" : 135,
    "Featherweight" : 145,
    "Lightweight" : 155,
    "Welterweight": 170,
    "Middleweight": 185,
    "Light Heavyweight": 205,
    "Heavyweight":265}
    response = requests.get(event_link)
    if response.status_code == 200:
        soup = BeautifulSoup(response.content, "html.parser")
        event_fights = soup.find("tbody", class_="b-fight-details__table-body").find_all("tr")
        fight_event = []
        for i in event_fights:
            if i.get("data-link") == fight_link:
                fight_event = i.find_all("p", class_="b-fight-details__table-text")
                break
        for i in fight_event:
            if "weight" in i.get_text(strip=True) or "Weight" in i.get_text(strip=True):
                return (weight_class_dict[i.get_text(strip=True)] if i.get_text(strip=True) in weight_class_dict else weight)
                

def update_csv(fighter_links, month_abbr):
    fighters = []
    opp_links = []
    opps = []
    for i in fighter_links:
        # Send a GET request to the URL
        response = requests.get(i)
        # Check if the request was successful
        if response.status_code == 200:
            # Parse the HTML content with BeautifulSoup
            soup = BeautifulSoup(response.content, "html.parser")
            links = [a.get('href') for a in soup.find_all('a', href=True)]
            fight_outcomes = soup.find_all("tr", class_="b-fight-details__table-row b-fight-details__table-row__hover js-fight-details-click")[:8] if len(soup.find_all("tr", class_="b-fight-details__table-row b-fight-details__table-row__hover js-fight-details-click")) > 6 else soup.find_all("tr", class_="b-fight-details__table-row b-fight-details__table-row__hover js-fight-details-click")
            # Extract general fighter information
            fighter_name, height, weight, reach, wins, losses, age = fighter_base_stats(soup, month_abbr)
            fighters.append(fighter_name)
            fight_links, links, opp_names = fighter_history(links, fighter_name, fight_outcomes)
            opp_links.extend(links)
            opps.extend(opp_names)
            fighter_exists = False
            with open('UFC Fighter Dataset.csv', 'rt') as f:
                reader = csv.reader(f, delimiter=',')
                for row in reader:
                    if fighter_name == row[0]: # if the username shall be on column 3 (-> index 2)
                        fighter_exists = True
                        break
                    else:
                        fighter_exists = False
                        
            if not fighter_exists:
                fighter_performance = fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, age, False)
                with open('UFC Fighter Dataset.csv', 'a') as file:
                    writer = csv.writer(file)
                    for i in fighter_performance:
                        writer.writerow(i)
            else:
                print(f"{fighter_name} is already in database")


            with open('UFC Outcomes.csv', 'rt') as f:
                reader = csv.reader(f, delimiter=',')
                for row in reader:
                    if fighter_name == row[0]: # if the username shall be on column 3 (-> index 2)
                        fighter_exists = True
                        break
                    else:
                        fighter_exists = False
                        
            if not fighter_exists:
                fighter_performance = fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, age, True) 
                with open('UFC Outcomes.csv', 'a') as file:
                    writer = csv.writer(file)
                    for i in fighter_performance:
                        writer.writerow(i)
            else:
                print(f"{fighter_name} outcome is already in database")
        else:
            print(f"Failed to fetch the webpage. Status code: {response.status_code}")
    df = pd.read_csv("UFC Fighter Dataset.csv")
    unique_count = df["Fighter Name"].nunique()
    last_fighter = df.iloc[-1]["Fighter Name"]
    print(f"# OF FIGHTERS CURRENTLY ADDED:\n{unique_count}")
    print(f"LAST FIGHTER ADDED:\n{last_fighter}")
    return fighters, opp_links, opps


def fit_for_training():
    fighter_input = str(input("Enter Fighter To Check: ")).strip()
    fighters = fighter_input.strip().split(",")
    for fighter_name in fighters:
        fighter_names = []
        with open("UFC Outcomes.csv", 'rt') as f:
            reader = csv.reader(f, delimiter=',')
            for row in reader:
                if fighter_name == row[0].strip():
                    fighter_names.append(row[2])
        if len(fighter_names) < 1:
            print(f"{fighter_name} is not fit for training:\nError Type: Fighter not logged in UFC Outcomes.")
            break
        else:
            fighter_dupe = fighter_names.copy()
            for i in fighter_names:
                with open("UFC Fighter Dataset.csv", 'rt') as f:
                    reader = csv.reader(f, delimiter=',')
                    for row in reader:
                        if i == row[0].strip():
                            fighter_dupe.remove(i)
                            break
            if len(fighter_dupe) == 0:
                print(f"{fighter_name} is fit for training")
            else:
                print(f"{fighter_name} is not fit for training\nError Type: Opponent Fight History not in database.\nMissing Fighters:\n{fighter_dupe}")      


