                fighter_ct = fight_data[9][fighter_idx] if fight_data[9][fighter_idx] != "--" else "0:00"
                opp_subatt, fighter_subatt = int(fight_data[7][opp_idx]), int(fight_data[7][fighter_idx])
                fight_performance.append([fighter_name, height, reach, wins, losses, age, fighter_weight, fight_id, fight_result, fighter_sig, fighter_td, fighter_kd, fighter_ct, fighter_subatt,  opp_sig, opp_td, opp_kd, opp_ct, opp_subatt, round, link])
                print(f"{fighter_name} Fight {fight_id} successfully in database")
            else:
                print(f"No fight stats table found for: {url}")
            del response, soup
            gc.collect()
    else:
        fight_id = 0
        for i in fight_links:
            fight_id += 1
            url = i
            for _ in range(5):
                try:
                    response = requests.get(url)
                    if response.status_code == 200:
                        break
                except requests.exceptions.RequestException as e:
                    time.sleep(5)
            round = 0
            soup = BeautifulSoup(response.content, "html.parser")
            fight_content = soup.find("div", class_="b-fight-details__content")
            if fight_content:
                fight_details = fight_content.find_all("i", class_="b-fight-details__label")
            else:
                print(f"Could not find fight details content for: {url}")
                fight_details = []
                break
            print(f"{fighter_name} Outcome {fight_id} in database")
            fighter_a = soup.find("i", class_="b-fight-details__person-status b-fight-details__person-status_style_green").find_next("div").find("a", class_="b-link b-fight-details__person-link").get_text(strip=True)
            fight_result = 1 if fighter_name in fighter_a else 0
            fighter_b = soup.find("i", class_="b-fight-details__person-status b-fight-details__person-status_style_gray").find_next("div").find("a", class_="b-link b-fight-details__person-link").get_text(strip=True)
            fight_performance.append([fighter_name, fighter_name, fighter_b if fight_result == 1 else fighter_a, fight_result, fight_id, link])
