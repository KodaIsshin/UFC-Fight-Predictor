def fighter_history(links, fighter_name, fight_outcomes, height, reach, overwrite=False):
    df = pd.read_csv("UFC Fighter Dataset.csv")
    of = pd.read_csv("UFC Outcomes.csv")

    # Extract full fight links  

    # Retrieve fighter rows and outcome rows
    fighter_rows = df.query("`Fighter Name` == @fighter_name and Height == @height and Reach == @reach")
    outcome_rows = of.query("`Fighter Name` == @fighter_name")
    # Extract opponent links and names
    opp_links, opp_names = extract_opp_info(fight_outcomes, fighter_name)
    # Filter fight outcomes and links
    # Extract fight numbers
    if fight_outcomes:
        fight_stats = fight_outcomes[0].find_all("p", class_="b-fight-details__table-text")
        fight_numbers = [stat.get_text(strip=True) for stat in fight_stats if stat.get_text(strip=True).isdigit()]
    if not fighter_rows.empty :
        # Get the most recent dataset fight if available
        dataset_fight = fighter_rows.iloc[-1] if not fighter_rows.empty else pd.DataFrame()

        # Prepare recent stats for comparison
        is_recent = get_recent_stats(dataset_fight, fight_numbers)

        # Check if dataset needs updating
        if is_recent or overwrite:
            df.drop(fighter_rows.index, inplace=True)
            of.drop(outcome_rows.index, inplace=True)
            df.to_csv("UFC Fighter Dataset.csv", index=False)
            of.to_csv("UFC Outcomes.csv", index=False)
            del fighter_rows, outcome_rows
            gc.collect()
        else:
            del fighter_rows, outcome_rows, df, of, full_links, opp_links, opp_names, fight_outcomes, dataset_fight, fight_numbers, dataset_recent
            gc.collect()
            return None, None, None


    # Process fight details from the first link
    full_links = []
    if links:
        for _ in range(5):
            try:
                response = requests.get(links[0])
                if response.status_code == 200:
                    soup = BeautifulSoup(response.content, "html.parser")
                    fight_content = soup.find("div", class_="b-fight-details__content")
                    if fight_content:
                        full_links = links[:6]  # Limit to 6 links
                    else:
                        full_links = links[:6]  # Limit to 6 links
                        event_title = soup.find("a", href=lambda x: x and "event-details" in x).get_text(strip=True)
                        print(f"{fighter_name} has an upcoming fight at {event_title}")
                    break
            except requests.exceptions.RequestException as e:
                time.sleep(5)
    del df, of
    gc.collect() 
    full_links.reverse()
    return full_links, opp_links[:6], opp_names[:6]



def extract_opp_info(fight_outcomes, fighter_name):
        """Extract opponent links, names, and indices for 'nc' or 'draw' outcomes."""
        opp_links, opp_names = [], []
        for idx, outcome in enumerate(fight_outcomes):
            result = outcome.find("i", class_="b-flag__text").get_text(strip=True)
            fighter_links = [
                link for link in outcome.find_all("a", class_="b-link b-link_style_black")
                if "fighter-details" in link.get("href")
            ]
            opp_links.extend(
                    [link.get("href") for link in fighter_links if link.get_text(strip=True) != fighter_name]
                )
            opp_names.extend(
                [link.get_text(strip=True) for link in fighter_links if link.get_text(strip=True) != fighter_name]
            )
    
        del result, fighter_links
        gc.collect()
        return opp_links, opp_names



def get_recent_stats(dataset_fight, fight_numbers):
    """Prepare recent stats for comparison."""
    dataset_recent = (
        [
            str(dataset_fight[col])
            for col in [
                'Knockdowns', 'Opp_Knockdowns', 'Sig_Strikes', 'Opp_Sig_Strikes',
                'Takedowns', 'Opp_Takedowns', 'Sub_Attempts', 'Opp_Sub_Attempts'
            ]
        ] if not dataset_fight.empty else []
    )
    fighter_recent = fight_numbers[:8]
    if dataset_recent != fighter_recent:
        return False
    else:
        return True

            

def fighter_base_stats(soup, month_dict):
    base_stats_html = soup.find_all("i", class_="b-list__box-item-title b-list__box-item-title_type_width")
    fighter_name = soup.find("span", class_="b-content__title-highlight").text.strip()
    date_birth = fighter_age(base_stats_html,month_dict)
    height = fighter_base_helper("Height", base_stats_html).split("' ")
    feet, inches = int(height[0]), int(height[1])
    height = (feet * 12) + (inches)
    weight = int(fighter_base_helper("Weight", base_stats_html).split()[0])
    reach = int(fighter_base_helper("Reach", base_stats_html))
    wins = int(soup.find("span", class_="b-content__title-record").text.split()[1].split("-")[0]) 
    losses = int(soup.find("span", class_="b-content__title-record").text.split()[1].split("-")[1])
    return fighter_name, height, weight, reach, wins, losses, date_birth


def fighter_base_helper(stat, stat_html):
    return [i.next_sibling.strip().strip(' " ') for i in stat_html if stat in i.string][0]

def fighter_age(stat_html,month_dict, fight=None, DOB=None):
    if fight == None:
        for i in stat_html:
            if "DOB" in i.get_text(strip=True):
                date_birth = i.next_sibling.get_text(strip=True)
                break
        return date_birth
    else:
        month_abbr_key = DOB.split()[0]  # Get the abbreviated month
        full_month_name = month_dict.get(month_abbr_key, month_abbr_key)  # Replace with full month name

        # Replace the abbreviated month with the full month in the DOB string
        corrected_dob_str = DOB.replace(month_abbr_key, full_month_name)

        # Convert the corrected DOB string to a datetime object
        dob = datetime.strptime(corrected_dob_str, "%B %d, %Y")  # %B is the full month name

        # Get today's date
        fight_date = datetime.strptime(fight, "%B %d, %Y")

        # Calculate the age
        age = fight_date.year - dob.year - ((fight_date.month, fight_date.day) < (dob.month, dob.day))
        return age



def fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, month_dict, outcomes, link, date_birth):
