            fight_winner = soup.find("i", class_="b-fight-details__person-status b-fight-details__person-status_style_green").find_next("div")
            fight_result = 1 if fighter_name in fight_winner.find("a", class_="b-link b-fight-details__person-link").get_text(strip=True) else 0
            for j in fight_details:
                if "Round:" in j.get_text(strip=True):
                    round = int(j.next_sibling.get_text(strip=True))
                    break
            fighter_weight, fight_date = weight_class(fight_event, i, weight)
            age = fighter_age(None,month_dict, fight_date, date_birth)
            fight_table = soup.find("tbody", class_="b-fight-details__table-body")
            if fight_table:
                rows = fight_table.find_all("td")
                fight_data = []
                for row in rows:
                    columns = [col.text.strip() for col in row.find_all("p", class_="b-fight-details__table-text")]
