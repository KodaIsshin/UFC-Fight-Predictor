def fighter_history(links, fighter_name, fight_outcomes, height, reach):
    def extract_links_and_indices(fight_outcomes, fighter_name):
        """Extract opponent links, names, and indices for 'nc' or 'draw' outcomes."""
        opp_links, opp_names, nc_draw_indices = [], [], []
        for idx, outcome in enumerate(fight_outcomes):
            result = outcome.find("i", class_="b-flag__text").get_text(strip=True)
            fighter_links = [
                link for link in outcome.find_all("a", class_="b-link b-link_style_black")
                if "fighter-details" in link.get("href")
            ]
            if result in ["nc", "draw"]:
                nc_draw_indices.append(idx)
            else:
                opp_links.extend(
                    [link.get("href") for link in fighter_links if link.get_text(strip=True) != fighter_name]
                )
                opp_names.extend(
                    [link.get_text(strip=True) for link in fighter_links if link.get_text(strip=True) != fighter_name]
                )
        return opp_links, opp_names, nc_draw_indices

    def filter_links_and_outcomes(links, fight_outcomes, exclude_indices):
        """Filter links and fight outcomes by excluding specific indices."""
        filtered_links = [link for idx, link in enumerate(links) if idx not in exclude_indices]
        filtered_outcomes = [outcome for idx, outcome in enumerate(fight_outcomes) if idx not in exclude_indices]
        return filtered_links, filtered_outcomes

    def get_recent_stats(dataset_fight, fight_numbers):
        """Prepare recent stats for comparison."""
        dataset_recent = (
            [
                str(dataset_fight[col])
                for col in [
                    'Knockdowns', 'Opp_Knockdowns', 'Sig_Strikes', 'Opp_Sig_Strikes',
                    'Takedowns', 'Opp_Takedowns', 'Sub_Attempts', 'Opp_Sub_Attempts'
                ]
            ] if not dataset_fight.empty else []
        )
        fighter_recent = fight_numbers[:8]
        return dataset_recent, fighter_recent

    # Extract full fight links
    full_links = [link for link in links if "fight-details" in link]

    # Retrieve fighter rows and outcome rows
    fighter_rows = df.query("`Fighter Name` == @fighter_name and Height == @height and Reach == @reach")
    outcome_rows = of.query("Fighter_Name == @fighter_name")

    # Extract opponent links, names, and 'nc/draw' indices
    opp_links, opp_names, nc_draw_indices = extract_links_and_indices(fight_outcomes, fighter_name)

    # Filter fight outcomes and links
    full_links, fight_outcomes = filter_links_and_outcomes(full_links, fight_outcomes, nc_draw_indices)

    # Extract fight numbers
    if fight_outcomes:
        fight_stats = fight_outcomes[0].find_all("p", class_="b-fight-details__table-text")
        fight_numbers = [stat.get_text(strip=True) for stat in fight_stats if stat.get_text(strip=True).isdigit()]
    else:
        fight_numbers = []

    # Get the most recent dataset fight if available
    dataset_fight = fighter_rows.iloc[-1] if not fighter_rows.empty else pd.DataFrame()

    # Prepare recent stats for comparison
    dataset_recent, fighter_recent = get_recent_stats(dataset_fight, fight_numbers)

    # Check if dataset needs updating
    if fighter_rows.empty or str(fighter_rows['Fighter_Link'].iloc[0]) == "nan" or dataset_recent != fighter_recent:
        df.drop(fighter_rows.index, inplace=True)
        of.drop(outcome_rows.index, inplace=True)
        df.to_csv("UFC Fighter Dataset.csv", index=False)
        of.to_csv("UFC Outcomes.csv", index=False)
        del fighter_rows, outcome_rows
        gc.collect()
    else:
        return None, None, None

    # Process fight details from the first link
    if full_links:
        response = requests.get(full_links[0])
        if response.status_code == 200:
            soup = BeautifulSoup(response.content, "html.parser")
            fight_content = soup.find("div", class_="b-fight-details__content")
            if fight_content:
                full_links = full_links[:6]
                fight_outcomes = fight_outcomes[:6]
            else:
                nc_draw_indices = [i + 2 for i in nc_draw_indices]
                event_title = soup.find("a", href=lambda x: x and "event-details" in x).get_text(strip=True)
                print(f"{fighter_name} has an upcoming fight at {event_title}")
                full_links = full_links[2:8] if len(full_links) > 8 else full_links[2:]

    # Reverse the links to maintain chronological order
    full_links.reverse()

    return full_links, opp_links[:6], opp_names[:6]

            

def fighter_base_stats(soup, month_dict):
    base_stats_html = soup.find_all("i", class_="b-list__box-item-title b-list__box-item-title_type_width")
    age = fighter_age(base_stats_html, month_dict)
    fighter_name = soup.find("span", class_="b-content__title-highlight").text.strip()
    height = fighter_base_helper("Height", base_stats_html).split("' ")
    feet, inches = int(height[0]), int(height[1])
    height = (feet * 12) + (inches)
    weight = int(fighter_base_helper("Weight", base_stats_html).split()[0])
    reach = int(fighter_base_helper("Reach", base_stats_html))
    wins = int(soup.find("span", class_="b-content__title-record").text.split()[1].split("-")[0]) 
    losses = int(soup.find("span", class_="b-content__title-record").text.split()[1].split("-")[1])
    return fighter_name, height, weight, reach, wins, losses, age


def fighter_base_helper(stat, stat_html):
    return [i.next_sibling.strip().strip(' " ') for i in stat_html if stat in i.string][0]

def fighter_age(stat_html, month_dict):
    for i in stat_html:
        if "DOB" in i.get_text(strip=True):
            DOB = i.next_sibling.get_text(strip=True)
            break
    month_abbr_key = DOB.split()[0]  # Get the abbreviated month
    full_month_name = month_dict.get(month_abbr_key, month_abbr_key)  # Replace with full month name

    # Replace the abbreviated month with the full month in the DOB string
    corrected_dob_str = DOB.replace(month_abbr_key, full_month_name)

    # Convert the corrected DOB string to a datetime object
    dob = datetime.strptime(corrected_dob_str, "%B %d, %Y")  # %B is the full month name

    # Get today's date
    today = datetime.today()

    # Calculate the age
    age = today.year - dob.year - ((today.month, today.day) < (dob.month, dob.day))
    return age


def fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, age, outcomes, link):
    fight_performance = []
    if outcomes == False:
        fight_id = 0
        for i in fight_links:
            url = i
            response = requests.get(url)
            fight_id += 1
            fighter_idx = 0
            opp_idx = 1
            if response.status_code == 200:
                round = 0
                soup = BeautifulSoup(response.content, "html.parser")
                fight_event = soup.find('h2', class_="b-content__title").find("a", class_="b-link")["href"] if soup.find('h2', class_="b-content__title") else "N/A"
                fight_content = soup.find("div", class_="b-fight-details__content")
                if fight_content:
                    fight_details = fight_content.find_all("i", class_="b-fight-details__label")
                else:
                    print(f"Could not find fight details content for: {url}")
                    fight_details = []
                    break
                fight_winner = soup.find("i", class_="b-fight-details__person-status b-fight-details__person-status_style_green").find_next("div")
                fight_result = 1 if fighter_name in fight_winner.find("a", class_="b-link b-fight-details__person-link").get_text(strip=True) else 0
                for j in fight_details:
                    if "Round:" in j.get_text(strip=True):
                        round = int(j.next_sibling.get_text(strip=True))
                        break
                fighter_weight = weight_class(fight_event, i, weight)
                # Locate the fight stats table
                fight_table = soup.find("tbody", class_="b-fight-details__table-body")
                # Check if the table was found
                if fight_table:
                    rows = fight_table.find_all("td")  # Skip the header row
                    
                    fight_data = []
                    for row in rows:
                        # Extract all text from table cells
                        columns = [col.text.strip() for col in row.find_all("p", class_="b-fight-details__table-text")]
                        if columns:
                            fight_data.append(columns)
                    if fight_data[0][1] == fighter_name:
                        fighter_idx = 1
                        opp_idx = 0
                    else:
                        fighter_idx = 0
                        opp_idx = 1
                    opp_sig, fighter_sig = int(fight_data[2][opp_idx].split()[0]), int(fight_data[2][fighter_idx].split()[0])
                    opp_td, fighter_td = int(fight_data[5][opp_idx].split()[0]), int(fight_data[5][fighter_idx].split()[0])
                    opp_kd, fighter_kd = int(fight_data[1][opp_idx]), int(fight_data[1][fighter_idx])
                    opp_ct, fighter_ct = fight_data[9][opp_idx], fight_data[9][fighter_idx]
                    opp_subatt, fighter_subatt = int(fight_data[7][opp_idx]), int(fight_data[7][fighter_idx])
                    #displays the information nearly exactly like my csv
                    fight_performance.append([fighter_name, height, reach, wins, losses, age, fighter_weight, fight_id, fight_result, fighter_sig, fighter_td, fighter_kd, fighter_ct, fighter_subatt,  opp_sig, opp_td, opp_kd, opp_ct, opp_subatt, round, link])
                    print(f"{fighter_name} Fight {fight_id} successfully in database")
                else:
                    print(f"No fight stats table found for: {url}")
            else:
                print(f"Failed to fetch fight details for: {url}")
    else:
        fight_id = 0
        for i in fight_links:
            fight_id += 1
            url = i
            response = requests.get(url)
            if response.status_code == 200:
                round = 0
                soup = BeautifulSoup(response.content, "html.parser")
                fight_content = soup.find("div", class_="b-fight-details__content")
                if fight_content:
                    fight_details = fight_content.find_all("i", class_="b-fight-details__label")
                else:
                    print(f"Could not find fight details content for: {url}")
                    fight_details = []
                    break
                print(f"{fighter_name} Outcome {fight_id} in database")
                fighter_a = soup.find("i", class_="b-fight-details__person-status b-fight-details__person-status_style_green").find_next("div").find("a", class_="b-link b-fight-details__person-link").get_text(strip=True)
                fight_result = 1 if fighter_name in fighter_a else 0
                fighter_b = soup.find("i", class_="b-fight-details__person-status b-fight-details__person-status_style_gray").find_next("div").find("a", class_="b-link b-fight-details__person-link").get_text(strip=True)
                fight_performance.append([(fighter_name), (fighter_name), (fighter_b if fight_result == 1 else fighter_a), fight_result, fight_id, link])
                time.sleep(1)
            else:
                print(f"Failed to fetch fight details for: {url}")

    return fight_performance

def weight_class(event_link, fight_link, weight):
    weight_class_dict = {"Flyweight" : 125,
    "Bantamweight" : 135,
    "Featherweight" : 145,
    "Lightweight" : 155,
    "Welterweight": 170,
    "Middleweight": 185,
    "Light Heavyweight": 205,
    "Heavyweight":265}
    response = requests.get(event_link)
    if response.status_code == 200:
        soup = BeautifulSoup(response.content, "html.parser")
        event_fights = soup.find("tbody", class_="b-fight-details__table-body").find_all("tr")
        fight_event = []
        for i in event_fights:
            if i.get("data-link") == fight_link:
                fight_event = i.find_all("p", class_="b-fight-details__table-text")
                break
        for i in fight_event:
            if "weight" in i.get_text(strip=True) or "Weight" in i.get_text(strip=True):
                return (weight_class_dict[i.get_text(strip=True)] if i.get_text(strip=True) in weight_class_dict else weight)
                

def update_csv(fighter_links, month_abbr):
    fighters = []
    opp_links = []
    opps = []

    # Load existing data into memory once
    fighter_df = pd.read_csv("UFC Fighter Dataset.csv")
    outcome_df = pd.read_csv("UFC Outcomes.csv")

    for i in fighter_links:
        # Fetch data from the URL
        response = requests.get(i)
        if response.status_code == 200:
            soup = BeautifulSoup(response.content, "html.parser")
            links = [a.get('href') for a in soup.find_all('a', href=True)]
            fight_outcomes = soup.find_all(
                "tr", class_="b-fight-details__table-row b-fight-details__table-row__hover js-fight-details-click"
            )[:10]

            # Extract fighter info
            fighter_name, height, weight, reach, wins, losses, age = fighter_base_stats(soup, month_abbr)
            fighters.append(fighter_name)

            # Check if the fighter exists in the dataset
            if fighter_name in fighter_df["Fighter Name"].values:
                print(f"{fighter_name} is up to date in the database.")
                del soup, links, fight_outcomes
                continue

            # Process fight history
            fight_links, opponent_links, opp_names = fighter_history(links, fighter_name, fight_outcomes, height, reach)
            if fight_links is None:
                print(f"{fighter_name} is up to date in the database.")
                del soup, links, fight_outcomes, fighter_name, height, weight, reach, wins, losses, fight_links, opponent_links, opp_names
                gc.collect()
                continue

            # Append opponent data
            opp_links.extend(opponent_links)
            opps.extend(opp_names)

            # Process fight performance
            fighter_performance = fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, age, False, i)
            fighter_df = pd.concat(
                [fighter_df, pd.DataFrame(fighter_performance)],
                ignore_index=True
            )

            # Process fight outcomes
            fighter_outcome = fight_stats(fight_links, fighter_name, height, weight, reach, wins, losses, age, True, i)
            outcome_df = pd.concat(
                [outcome_df, pd.DataFrame(fighter_outcome)],
                ignore_index=True
            )

            # Cleanup
            del soup, links, fight_outcomes, fighter_name, height, weight, reach, wins, losses, fight_links, opponent_links, opp_names
            gc.collect()
        else:
            print(f"Failed to fetch the webpage. Status code: {response.status_code}")

    # Save updated dataframes to CSV
    fighter_df.to_csv("UFC Fighter Dataset.csv", index=False)
    outcome_df.to_csv("UFC Outcomes.csv", index=False)

    print(f"# OF FIGHTERS CURRENTLY ADDED: {fighter_df['Fighter Name'].nunique()}")
    print(f"LAST FIGHTER ADDED: {fighter_df.iloc[-1]['Fighter Name']}")
    return fighters, opp_links, opps


def fit_for_training():
    fighter_input = str(input("Enter Fighter To Check: ")).strip()
    fighters = fighter_input.strip().split(",")
    for fighter_name in fighters:
        fighter_names = []
        with open("UFC Outcomes.csv", 'rt') as f:
            reader = csv.reader(f, delimiter=',')
            for row in reader:
                if fighter_name == row[0].strip():
                    fighter_names.append(row[2])
        if len(fighter_names) < 1:
            print(f"{fighter_name} is not fit for training:\nError Type: Fighter not logged in UFC Outcomes.")
            break
        else:
            fighter_dupe = fighter_names.copy()
            for i in fighter_names:
                with open("UFC Fighter Dataset.csv", 'rt') as f:
                    reader = csv.reader(f, delimiter=',')
                    for row in reader:
                        if i == row[0].strip():
                            fighter_dupe.remove(i)
                            break
            if len(fighter_dupe) == 0:
                print(f"{fighter_name} is fit for training")
            else:
                print(f"{fighter_name} is not fit for training\nError Type: Opponent Fight History not in database.\nMissing Fighters:\n{fighter_dupe}")      


